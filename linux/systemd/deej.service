[Unit]
Description=deej volume mixer
After=graphical-session.target sound.target

[Service]
ExecStart=/opt/deej/deej
WorkingDirectory=/opt/deej

# on-failure, not always: deej exits 0 only when asked to (tray Quit, SIGTERM),
# and exits 1 when it loses the audio server, which is the case that needs a
# restart. A missing serial port is retried in-process, so it never exits for
# that. With always, Quit from the tray was undone 3 seconds later.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
